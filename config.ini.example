# OxyRoute Application Configuration
# Copy this file to config.ini and adjust values for your environment.

[POSTGRES]
# PostgreSQL database configuration
DATABASE = postgresql
DRIVER = asyncpg
DATABASE_NAME = oxyroute_db
USERNAME = postgres
PASSWORD = your_password
IP = localhost
PORT = 5432

# Connection pool settings
DATABASE_ENGINE_POOL_TIMEOUT = 30
DATABASE_ENGINE_POOL_RECYCLE = 3600
DATABASE_ENGINE_POOL_SIZE = 5
DATABASE_ENGINE_MAX_OVERFLOW = 10
DATABASE_ENGINE_POOL_PING = true

# Database echo (SQL logging) - set to false in production
DATABASE_ECHO = false

[GRANIAN]
# Granian RSGI server configuration
HOST = 0.0.0.0
PORT = 8000
WORKERS = 2

# Event loop: asyncio | uvloop | auto
LOOP = uvloop

# HTTP: auto | http1 | http2
HTTP = auto

[REDIS]
# Redis cache configuration
HOST = localhost
PORT = 6379
DB = 0
# Local dev (`docker-compose.dev.yml`): leave empty (Redis without auth).
# Production stack (`./start.sh`): set a strong password (compose uses requirepass).
PASSWORD =

[DOCS]
# Whether to expose /openapi.json and /api/docs (Scalar UI). Set to false in production.
ENABLED = true
# HTTP Basic credentials for /api/docs (Scalar API Reference).
USERNAME = admin
PASSWORD = change_me

[CORS]
# Comma-separated list of allowed origins. Use * only for trusted internal APIs.
ALLOW_ORIGINS = *
ALLOW_METHODS = GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOW_HEADERS = authorization,content-type
ALLOW_CREDENTIALS = false
MAX_AGE = 600

[SECURITY]
# Browser security headers. Leave HSTS empty if you do not terminate TLS at this layer.
HSTS =
CONTENT_SECURITY_POLICY = default-src 'self'
REFERRER_POLICY = strict-origin-when-cross-origin
X_FRAME_OPTIONS = DENY
X_CONTENT_TYPE_OPTIONS = nosniff

[JWT]
# Shared secret for HS256 routes (require_jwt=True). Leave empty to disable JWT example.
SECRET =
ALGORITHM = HS256
ISSUER =
AUDIENCE =
LEEWAY = 0
